{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://story2-api.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://story2-api.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
