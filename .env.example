# Copie para backend/.env e preencha se quiser geracao real com Gemini.
# Sem GEMINI_API_KEY o worker usa placeholders (offline).

JWT_SECRET=change-me-in-production
GEMINI_API_KEY=
OFFLINE_FALLBACK=true

# Animacao / narrado animado (Kling)
# Console novo (uma chave so): KLING_API_KEY=api-key-kling-...
# Console antigo (Access + Secret): KLING_ACCESS_KEY + KLING_SECRET_KEY
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
DEFAULT_VIDEO_DURATION_S=5

# Video narrado (TTS) � sem ElevenLabs usa edge-tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
